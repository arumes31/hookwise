# ConnectWise API Configuration
CW_URL=https://api-na.myconnectwise.net/v4_6_release/apis/3.0
CW_COMPANY=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
CW_CLIENT_ID=
CW_TICKET_PREFIX=Alert:

# ConnectWise Ticket Defaults
CW_SERVICE_BOARD=Service Board
CW_STATUS_NEW=New
CW_STATUS_CLOSED=Closed
CW_DEFAULT_COMPANY_ID=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database Configuration
# Compose builds DATABASE_URL from POSTGRES_PASSWORD. For a direct local run,
# set an explicit URL instead.
POSTGRES_PASSWORD=
# DATABASE_URL=sqlite:///hookwise.db
# DATABASE_URL=postgresql://hookwise:<password>@localhost:5432/hookwise

# Flask & Security Configuration
SECRET_KEY=
PORT=5000
DEBUG_MODE=false
FORCE_HTTPS=false
HTTPS_ORIGIN=https://hookwise.example.com
USE_PROXY=false
PROXY_FIX_COUNT=1
ENCRYPTION_KEY=

# Web GUI Auth
GUI_USERNAME=admin
GUI_PASSWORD=
GUI_TRUSTED_IPS=

# Celery
# Compose builds CELERY_BROKER_URL from REDIS_PASSWORD. Set this only for a
# direct local run.
# CELERY_BROKER_URL=redis://:<password>@localhost:6379/0

# Other Configuration
LOG_RETENTION_DAYS=30
LLM_CONNECT_TIMEOUT=5
LLM_TIMEOUT=180
